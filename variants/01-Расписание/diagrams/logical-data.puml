@startuml
entity "Преподаватель\n<<внешний>>" as Teacher {
  * идентификатор
  --
  ФИО
  кафедра
}
entity "Учебная группа\n<<внешний>>" as Group {
  * идентификатор
  --
  название группы
}
entity "Аудитория\n<<внешний>>" as Room {
  * идентификатор
  --
  номер аудитории
  корпус
}
entity "Нагрузка по дисциплине\n<<внешний>>" as Load {
  * идентификатор
  --
  дисциплина
  тип занятия
  часы
}
entity "Версия расписания" as Schedule {
  * номер версии
  --
  семестр
  статус
}
entity "Занятие" as Lesson {
  * номер
  --
  день и время
  период проведения
  статус
}
entity "Запись журнала\nизменений" as Journal {
  * номер записи
  --
  вид изменения
  было
  стало
  время
  автор
}
entity "Уведомление" as Notice {
  * номер
  --
  вид
  статус отправки
}
entity "Сопоставление\nаккаунта MAX" as Account {
  * аккаунт MAX
  --
  группа или преподаватель
}
Schedule ||--o{ Lesson : содержит
Load ||--o{ Lesson : покрывается
Teacher ||--o{ Lesson : ведёт
Group ||--o{ Lesson : посещает
Room ||--o{ Lesson : принимает
Lesson ||--o{ Journal : меняется
Journal ||--o{ Notice : порождает
Account ||--o{ Notice : получает
Group ||--o{ Account : сопоставлена
Teacher ||--o{ Account : сопоставлен
@enduml