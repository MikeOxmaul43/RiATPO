@startuml tobe
title TO-BE. Справка через личный кабинет

|Студент|
start
:Указать вид и адресата\nв личном кабинете;

|Личный кабинет|
:Проверить статус\nв учёте контингента;

if (Числится?) then (нет)
  :Показать причину в кабинете;
  stop
else (да)
endif

if (Вид в перечне\nавтоматической выдачи?) then (да)
  :Собрать PDF по шаблону;
  :Подписать электронной\nподписью организации;
  fork
    :Положить файл в личный кабинет;
  fork again
    :Записать выдачу в журнал;
  end fork
  stop
else (нет)
  :Создать заявку\n«на рассмотрении»;
  |Секретарь|
  :Рассмотреть заявку;
  if (Решение?) then (подтвердить)
    |Личный кабинет|
    :Собрать PDF и подписать;
    fork
      :Положить файл в личный кабинет;
    fork again
      :Записать выдачу в журнал;
    end fork
    stop
  else (отклонить)
    :Сохранить причину отказа;
    |Студент|
    :Увидеть причину в кабинете;
    stop
  endif
endif

@enduml
